{
  "name": "@veltrixsecops/mcp-server",
  "version": "1.0.0",
  "description": "Veltrix MCP server — connect AI assistants to Veltrix through the Model Context Protocol. Propose-only, enforced by the platform: agents draft, validate and submit security-tool configuration; people approve in the portal.",
  "license": "MIT",
  "homepage": "https://www.veltrixsecops.com/documentations/mcp-server.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/captivatortechnologies/veltrix-apps.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/captivatortechnologies/veltrix-apps/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "veltrix",
    "security-as-code",
    "ai-governance",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "veltrix-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "smoke": "node scripts/e2e-smoke.js",
    "prepublishOnly": "npm run build && npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
